        },
        {
          "type": "null"
        }
      ]
    },
    "runtimes": {
      "additionalProperties": {
        "$ref": "#/$defs/RawRuntime"
      },
      "type": "object"
    },
    "server": {
      "$ref": "#/$defs/RawServer"
    },
    "store": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawStore"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "Unsworn configuration",
  "type": "object"
}
