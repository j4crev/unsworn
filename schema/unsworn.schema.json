            "keys": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StringOrList"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The valid keys: a list, or a comma-separated string."
            },
            "query": {
              "description": "The query parameter that carries the key.",
              "type": [
                "string",
                "null"
              ]
            },
            "timeout": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Duration"
                },
                {
                  "type": "null"
                }
              ],
              "description": "How long to wait for `url` before answering `503`. Default: 2s."
            },
            "type": {
              "const": "api_key",
              "type": "string"
            },
            "url": {
              "description": "An OAuth 2.0 token introspection endpoint (RFC 7662) that verifies\nkeys, instead of `keys`.",
              "type": [
                "string",
                "null"
              ]
