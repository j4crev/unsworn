      "enum": [
        "off",
        "log",
        "enforce"
      ],
      "type": "string"
    },
    "SchemaRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ],
      "description": "A JSON Schema reference: a file path, or an inline schema table."
    },
    "Size": {
      "anyOf": [
        {
          "pattern": "^[0-9]+(\\.[0-9]+)?\\s*([kKmMgG][iI]?[bB]?|[bB])?$",
          "type": "string"
        },
        {
          "minimum": 0,
          "type": "integer"
        }
      ],
      "description": "A size like \"1MB\" or \"512KB\" (1024-based), or a number of bytes."
    },
    "StoreBackend": {
      "oneOf": [
        {
          "const": "memory",
          "description": "In this process only. Fine for a single instance.",
          "type": "string"
        },
        {
          "const": "redis",
          "description": "Shared by every instance that uses the same Redis (or Valkey, Dragonfly...).",
          "type": "string"
        }
      ]
    },
    "StringOrList": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "TrailingSlash": {
      "enum": [
        "redirect",
        "strict",
        "ignore"
      ],
      "type": "string"
    }
