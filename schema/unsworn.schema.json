{
  "$defs": {
    "Array_of_stringOrOff": {
      "anyOf": [
        {
          "const": "off",
          "description": "Switch off a setting inherited from a broader layer."
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "Duration": {
      "anyOf": [
        {
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d))+$",
          "type": "string"
        },
        {
          "minimum": 0,
          "type": "integer"
        }
      ],
      "description": "A duration like \"30s\", \"5m\", \"250ms\" or \"1h30m\", or a number of seconds."
    },
    "ListTools": {
      "description": "What `tools/list` shows a caller.",
      "oneOf": [
        {
          "const": "permitted",
          "description": "Only tools whose `auth` scopes the caller's token has.",
          "type": "string"
        },
        {
          "const": "all",
          "description": "Every tool. Calls are still checked.",
          "type": "string"
        }
      ]
    },
    "OnError": {
      "oneOf": [
        {
          "const": "open",
          "description": "Let requests through without counting them.",
          "type": "string"
        },
        {
          "const": "closed",
          "description": "Answer `503`.",
          "type": "string"
        }
      ]
    },
    "Protocol": {
      "oneOf": [
        {
          "const": "jsonl",
          "description": "Tier 1: JSON lines over stdin/stdout.",
          "type": "string"
        },
        {
          "const": "framed",
          "description": "Tier 2: length-prefixed frames over a Unix socket.",
          "type": "string"
        },
        {
          "const": "binary",
          "deprecated": true,
          "description": "Deprecated: the old name for `framed`.",
          "type": "string"
        }
      ]
    },
    "RawAuth": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/RawAuthAlt"
        },
        {
          "items": {
            "$ref": "#/$defs/RawAuthItem"
          },
          "type": "array"
        }
      ],
      "description": "`auth` as written: `\"jwt\"`, `\"none\"`, `[\"jwt\", \"service\"]`,\n`{ scheme = \"jwt\", scopes = [...] }`, or a list of those."
    },
    "RawAuthAlt": {
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string"
        },
        "scopes": {
