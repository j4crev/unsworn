{
  "name": "@unswornjs/sdk",
  "version": "0.2.0",
  "description": "Write Unsworn handlers in JavaScript or TypeScript (Bun, Node, Deno), and run Unsworn projects on Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j4crev/unsworn.git",
    "directory": "sdk/js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./cloudflare": "./src/cloudflare.ts"
  },
  "files": [
    "src",
    "wasm",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "../../crates/unsworn-wasm/build.sh --check-size"
  },
  "publishConfig": {
    "access": "public"
  }
}
